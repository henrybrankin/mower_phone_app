/ {
	chosen {
		zephyr,code-partition = &slot0_partition;
	};
};

&flash0 {
	/delete-node/ partitions;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		samba_partition: partition@0 {
			label = "sam-ba";
			reg = <0x00000000 0x00010000>;
			read-only;
		};

		manager_partition: partition@10000 {
			label = "mcuboot";
			reg = <0x00010000 0x00010000>;
			read-only;
		};

		slot0_partition: partition@20000 {
			label = "image-0";
			reg = <0x00020000 0x0006e000>;
		};

		slot1_partition: partition@8e000 {
			label = "image-1";
			reg = <0x0008e000 0x0006e000>;
		};

		scratch_partition: partition@fc000 {
			label = "image-scratch";
			reg = <0x000fc000 0x00004000>;
		};
	};
};
